<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net11.0;net10.0;net8.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>Vessel</RootNamespace>
		<IsAotCompatible>true</IsAotCompatible>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>VesselStorage</PackageId>
		<Product>Vessel</Product>
		<Authors>Erik Barale</Authors>
		<Description>An Object Storage core library for .NET</Description>
		<Copyright>Copyright (c) 2026 Erik Barale</Copyright>

		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>Icon.png</PackageIcon>

		<RepositoryUrl>https://github.com/noyzone99/Vessel</RepositoryUrl>
		<PackageProjectUrl>https://github.com/noyzone99/Vessel</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<GenerateDependencyFile>false</GenerateDependencyFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Assets\README.md" Pack="true" PackagePath="\" />
		<None Include="Assets\Icon.png" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
		<PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
		<PackageReference Include="ZoneTree" Version="1.9.9" />
		<PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
	</ItemGroup>

	<ItemGroup>
	  <InternalsVisibleTo Include="Vessel.UnitTests" />
	  <InternalsVisibleTo Include="Vessel.Native" />
	</ItemGroup>

</Project>
