<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<PublishAot>true</PublishAot>
		<NativeLib>Shared</NativeLib>
		<InvariantGlobalization>true</InvariantGlobalization>
		<AssemblyName>vessel</AssemblyName>
		<NativeBinaryPrefix Condition="'$(OS)' != 'Windows_NT'">lib</NativeBinaryPrefix>
		<SharedLibraryInstallName>@rpath/libvessel.dylib</SharedLibraryInstallName>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
		<StripSymbols>true</StripSymbols>
	</PropertyGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<None Include="vessel.h">
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<TargetPath>vessel.h</TargetPath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Vessel.Core\Vessel.Core.csproj" />
	</ItemGroup>

</Project>
