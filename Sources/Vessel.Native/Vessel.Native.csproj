<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<PublishAot>true</PublishAot>
		<NativeLib>Shared</NativeLib>
		<InvariantGlobalization>true</InvariantGlobalization>
		<NativeBinaryPrefix Condition="'$(OS)' != 'Windows_NT'">lib</NativeBinaryPrefix>
		<SharedLibraryInstallName>@rpath/libvessel.dylib</SharedLibraryInstallName>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
		<StripSymbols>true</StripSymbols>
	</PropertyGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<None Include="vessel.h">
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<TargetPath>vessel.h</TargetPath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Vessel\Vessel.csproj" />
	</ItemGroup>

	<!-- Keep the native library name distinct from the project assembly name during publish. -->
	<Target Name="SetVesselNativeBinaryName" BeforeTargets="LinkNative">
		<PropertyGroup>
			<TargetName>vessel</TargetName>
			<NativeBinary>$(NativeOutputPath)$(NativeBinaryPrefix)$(TargetName)$(NativeBinaryExt)</NativeBinary>
			<NativeImportLibrary Condition="'$(NativeImportLibrary)' != ''">$(NativeOutputPath)$(NativeBinaryPrefix)$(TargetName)$(LibFileExt)</NativeImportLibrary>
			<_LinkNativeOutputs>$(NativeBinary)</_LinkNativeOutputs>
			<_LinkNativeOutputs Condition="'$(NativeImportLibrary)' != ''">$(NativeBinary);$(NativeImportLibrary)</_LinkNativeOutputs>
		</PropertyGroup>
	</Target>

	<Target Name="WriteVesselStaticLinkInputs" AfterTargets="LinkNative"
		Condition="'$(NativeLib)' == 'Static' and '$(VesselStaticLinkInputs)' != ''">
		<WriteLinesToFile File="$(VesselStaticLinkInputs)" Overwrite="true"
			Lines="archive|$(NativeObject);@(NativeLibrary->'archive|%(FullPath)');@(SdkNativeLibrary->'system|%(Identity)');@(NativeSystemLibrary->'system|%(Identity)');runtime|$(IlcSdkPath)" />
	</Target>

</Project>
