<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TargetFramework>net11.0</TargetFramework>
		<IsTestProject>true</IsTestProject>
		<IsPackable>false</IsPackable>
		<LangVersion>latest</LangVersion>
		<DisableTransitiveProjectReferences>false</DisableTransitiveProjectReferences>
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
		<PackageReference Include="Moq" Version="4.21.0" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
		<PackageReference Include="xunit.v3" Version="4.0.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Sources\Vessel.Core\Vessel.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

</Project>
